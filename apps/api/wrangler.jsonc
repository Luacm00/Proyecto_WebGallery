// Configuarcion del worker
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Entorno por defecto = desarrollo local (wrangler dev)
  "name": "webgallery-api-dev",
  "main": "src/index.ts",
  // Fija el comportamiento del runtime a esta fecha: actualizaciones de
  // Cloudflare no cambian tu Worker sin que tú lo decidas.
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true }, //logs visibles en el panel
  "vars": {
    // Variables NO secretas. Los secretos van con `wrangler secret put`.
    "ALLOWED_ORIGINS": "http://localhost:3000,https://webgallery-2bc.pages.dev",
    "SUPABASE_URL": "http://127.0.0.1:55321",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH",
    "MEDIA_BASE_URL": "http://localhost:3000/img"
  },

  "env": {
    "production": {
      // Mismo nombre que el worker actual -> misma URL, no se crea uno nuevo
      "name": "webgallery-api",
      // Las vars NO se heredan: se declaran completas. Sin localhost.
      "vars": {
        "ALLOWED_ORIGINS": "https://webgallery-2bc.pages.dev",
        "SUPABASE_URL": "https://dhflmjozpomcsnanesno.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_eu5_TkwMPCSZhpBvT7Ft-A_7d-vwVxB",
        "MEDIA_BASE_URL": "https://webgallery-2bc.pages.dev/img"
      },
    },
  },
}
